# Arquivos que rodam no Linux precisam de quebra de linha LF, mesmo quando o
# repositório é clonado no Windows (com CRLF o bash falha com "\r: command not found").
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
deploy/** text eol=lf
*.png binary
*.jpg binary
*.webp binary
