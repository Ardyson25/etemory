# /srv/etermory/.env nas VMs de aplicação (dono deploy, grupo etermory, modo 640).
# app1 e app2 usam o MESMO arquivo, mudando só INSTANCIA.
# IMPORTANTE: SECRET_KEY tem de ser IGUAL nas duas instâncias. A sessão do
# usuário fica num cookie assinado com ela; com chaves diferentes, o usuário
# seria deslogado toda vez que o Nginx trocasse de instância.
ETERMORY_AMBIENTE=producao
INSTANCIA=app1
SECRET_KEY=[GERAR: python3 -c "import secrets; print(secrets.token_hex(32))"]
DATABASE_URL=postgresql+psycopg://etermory:[SENHA_DO_BANCO]@vm-db:5432/etermory
ARMAZENAMENTO=disco
UPLOAD_FOLDER=/srv/etermory-uploads
LOG_FILE=/var/log/etermory/app.log
COOKIE_SEGURO=1
ATRAS_DE_PROXY=1
FORWARDED_ALLOW_IPS=192.168.56.10
WEB_CONCURRENCY=3
