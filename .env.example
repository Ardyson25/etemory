# Copie para .env e preencha. O .env NUNCA vai para o Git.

# desenvolvimento | producao
ETERMORY_AMBIENTE=desenvolvimento

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Sem DATABASE_URL, o desenvolvimento usa SQLite em instance/etermory.db.
# Produção usa PostgreSQL:
# DATABASE_URL=postgresql+psycopg://etermory:SENHA@192.168.56.20:5432/etermory
# Neon (Fase 3), string DIRETA, sem "-pooler":
# DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Nome da instância mostrado em /saude (app1, app2...)
INSTANCIA=local

# Onde guardar as fotos: "disco" (pasta abaixo) ou "banco" (tabela arquivos).
# Render gratuito (Fase 3): banco. VMs (Fase 4): disco.
ARMAZENAMENTO=disco

# Pasta das fotos (na Fase 4, a pasta compartilhada por NFS)
# UPLOAD_FOLDER=/srv/etermory-uploads

# Arquivo de log da aplicação (Fase 4)
# LOG_FILE=/var/log/etermory/app.log

# 1 quando o site usa HTTPS (cookies só trafegam criptografados)
COOKIE_SEGURO=0

# 1 quando roda atrás do Nginx (lê o IP real e o protocolo)
ATRAS_DE_PROXY=0
